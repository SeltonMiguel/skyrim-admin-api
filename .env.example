JWT_REFRESH_TTL=7d

# Only for the explicit staff:bootstrap command. Remove after use.
BOOTSTRAP_COORDINATOR_USERNAME=
BOOTSTRAP_COORDINATOR_DISPLAY_NAME=
BOOTSTRAP_COORDINATOR_PASSWORD=
