NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=skyrim
DB_PASSWORD=skyrim
DB_DATABASE=skyrim_admin
# Optional: defaults to true in development and false in test/production.
# DB_LOGGING=false

# Required, distinct random secrets (at least 32 characters each).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GAME_BRIDGE_HEARTBEAT_TIMEOUT_MS=30000
GAME_COMMAND_ACK_TIMEOUT_MS=5000
GAME_COMMAND_EXECUTION_TIMEOUT_MS=30000
GAME_COMMAND_MAX_DISPATCH_ATTEMPTS=3

# Only for the explicit staff:bootstrap command. Remove after use.
BOOTSTRAP_COORDINATOR_USERNAME=
BOOTSTRAP_COORDINATOR_DISPLAY_NAME=
BOOTSTRAP_COORDINATOR_PASSWORD=
