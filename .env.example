NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=skyrim
DB_PASSWORD=skyrim
DB_DATABASE=skyrim_admin
# Optional: defaults to true in development and false in test/production.
# DB_LOGGING=false
# Database TLS: disable | require (encrypt, no verification) | verify-full.
# REQUIRED (explicit) in production. DB_SSL_CA_FILE only with verify-full.
DB_SSL_MODE=disable
# DB_SSL_CA_FILE=
# Pool per replica (total = replicas x DB_POOL_MAX, +1 lock connection).
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=5000
# API queries: client timeout <= server statement_timeout.
# DB_QUERY_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000
# Migration runner only (never the API timeout).
# DB_MIGRATION_STATEMENT_TIMEOUT_MS=600000
# DB_MIGRATION_LOCK_TIMEOUT_MS=10000

# Deployment (12.2). Do not run more than one backend replica before
# Stage 12.5. Only SINGLE is accepted; the PostgreSQL single-instance lock is
# always on in production (optional elsewhere).
# BACKEND_TOPOLOGY=SINGLE
# SINGLE_INSTANCE_LOCK_ENABLED=false
# Upper bound of the graceful shutdown (orchestrator stop timeout must exceed it).
# SHUTDOWN_TIMEOUT_MS=8000

# Required, distinct random secrets (at least 32 characters each).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Player authentication: distinct secrets, never the staff ones (32+ chars each).
PLAYER_JWT_ACCESS_SECRET=
PLAYER_JWT_REFRESH_SECRET=
PLAYER_JWT_ACCESS_TTL=15m
PLAYER_JWT_REFRESH_TTL=30d
# Per-process, per-IP limit for player exchange/refresh.
PLAYER_AUTH_RATE_LIMIT_PER_MINUTE=20
# Lifetime of the in-game character link challenge (1m to 1h).
PLAYER_LINK_CHALLENGE_TTL=10m
# Lifetime of a pending group invite (1m to 24h).
PLAYER_GROUP_INVITE_TTL=10m
# Lifetime of a pending guild invite (1h to 30d).
PLAYER_GUILD_INVITE_TTL=7d
# Chat messages are hidden after this retention (1d to 30d).
PLAYER_CHAT_RETENTION=7d
# Chat anti-spam: messages per player + character in a window (single instance).
PLAYER_CHAT_RATE_LIMIT_COUNT=5
PLAYER_CHAT_RATE_LIMIT_WINDOW=10s
# Time a WebSocket has to send its AUTH frame before being closed.
REALTIME_AUTH_TIMEOUT_MS=5000

# Optional Discord OAuth2 app (server-side only; never shipped to Electron).
# DISCORD_REDIRECT_URIS is a comma-separated exact-match allowlist.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URIS=

GAME_BRIDGE_HEARTBEAT_TIMEOUT_MS=30000
# Host Agent WebSocket (/api/v1/agent): time to send HELLO, heartbeat cadence
# announced to the Agent and the silence after which the session is closed.
# The timeout must exceed the interval and not exceed GAME_BRIDGE_HEARTBEAT_TIMEOUT_MS.
AGENT_AUTH_TIMEOUT_MS=5000
AGENT_HEARTBEAT_INTERVAL=10s
AGENT_HEARTBEAT_TIMEOUT=30s
# GameCommands in flight per server (counted in the database).
AGENT_MAX_IN_FLIGHT_COMMANDS=32
# Authenticated Agent frames per session per window; excess closes the socket.
AGENT_MESSAGE_RATE_LIMIT_COUNT=200
AGENT_MESSAGE_RATE_LIMIT_WINDOW_MS=10000
# Best-effort push of new gameplay work (WORK_ITEMS) to connected Agents;
# WORK_SYNC recovers anything missed.
AGENT_WORK_PUSH_INTERVAL_MS=2000
# VIP CHARACTER reward delivery worker (creates/reconciles GameCommands).
VIP_DELIVERY_WORKER_INTERVAL_MS=2000
GAME_COMMAND_ACK_TIMEOUT_MS=5000
GAME_COMMAND_EXECUTION_TIMEOUT_MS=30000
GAME_COMMAND_MAX_DISPATCH_ATTEMPTS=3
# A PENDING command never reserved (no ready Agent) fails after this.
GAME_COMMAND_PENDING_TIMEOUT_MS=60000
# Dispatch/expiry worker cadence.
GAME_COMMAND_WORKER_INTERVAL_MS=500
# Server Control (at-most-once, never resent). An operation never sent fails
# after the pending timeout; notAfter = claim + delivery window (the Agent
# refuses later execution); a sent operation without a result becomes
# UNCERTAIN after the result timeout, which must exceed the delivery window.
SERVER_CONTROL_PENDING_TIMEOUT_MS=30000
SERVER_CONTROL_DELIVERY_WINDOW_MS=10000
SERVER_CONTROL_RESULT_TIMEOUT_MS=300000
SERVER_CONTROL_WORKER_INTERVAL_MS=1000

# Security and abuse controls (12.1). See docs/security.md.
# Proxy trust: false (default, X-Forwarded-For ignored), a hop count, or a
# comma list of loopback/linklocal/uniquelocal/IPs/CIDRs. Never "true".
TRUST_PROXY=false
# Exact browser origins (scheme://host[:port]) for CORS and the realtime
# upgrade. Empty: no CORS headers; any browser Origin refused in production.
CORS_ORIGINS=
# REALTIME_ALLOWED_ORIGINS=       (defaults to CORS_ORIGINS)
# SWAGGER_ENABLED=                (default: on outside production, off in production)
# SECURITY_HSTS_MAX_AGE_SECONDS=0 (0 = no HSTS; enable only behind TLS)
# AUTH_REFRESH_REUSE_GRACE_MS=10000
# Per-process baselines, to be tuned by the 12.6 load tests:
# STAFF_LOGIN_RATE_LIMIT_WINDOW=15m
# STAFF_LOGIN_RATE_LIMIT_PER_IP=30
# STAFF_LOGIN_RATE_LIMIT_PER_USERNAME=10
# STAFF_LOGIN_MAX_CONCURRENT=4
# STAFF_REFRESH_RATE_LIMIT_WINDOW=1m
# STAFF_REFRESH_RATE_LIMIT_PER_IP=60
# STAFF_REFRESH_RATE_LIMIT_PER_SESSION=10
# REALTIME_MAX_CONNECTIONS=10000
# REALTIME_MAX_PENDING_CONNECTIONS=500
# REALTIME_MAX_CONNECTIONS_PER_IDENTITY=5
# REALTIME_CONNECT_RATE_LIMIT_PER_MINUTE=60
# AGENT_MAX_PENDING_CONNECTIONS=32
# AGENT_MAX_CONCURRENT_AUTH=8
# AGENT_CONNECT_RATE_LIMIT_PER_MINUTE=30
# AGENT_AUTH_FAILURE_LIMIT_PER_MINUTE=10
# PLAYER_CHARACTER_QUERY_RATE_LIMIT_PER_MINUTE=30
# PLAYER_MARKET_MUTATION_RATE_LIMIT_PER_MINUTE=30

# Only for the explicit staff:bootstrap command. Remove after use.
BOOTSTRAP_COORDINATOR_USERNAME=
BOOTSTRAP_COORDINATOR_DISPLAY_NAME=
BOOTSTRAP_COORDINATOR_PASSWORD=
